# ─── SmartBasket — Variables de entorno ───────────────────────────────────────
# Copiar a .env y ajustar según tu entorno

# ─── GPU / CUDA ───
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# ─── Paths internos del contenedor (no modificar) ───
PYTHONPATH=/app/src
TRANSFORMERS_CACHE=/app/models/vlm
HF_HOME=/app/models/vlm

# ─── HuggingFace (opcional, para descargas privadas) ───
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Configuración del pipeline ───
DEFAULT_CONFIG=/app/configs/default.yaml
LOG_LEVEL=INFO

# ─── VLM Service ───
VLM_SERVICE_URL=http://vlm:8001
VLM_ENABLED=true

# ─── Roboflow (opcional, para descargar datasets) ───
# ROBOFLOW_API_KEY=your_api_key_here
