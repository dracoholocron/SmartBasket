# sports-data-api — local dev config
# Copia este archivo a `.env` y ajusta si hace falta.

# Postgres — driver asyncpg para runtime, psycopg2 NO se usa.
# DATABASE_URL: rol superuser `sportsdata`. Lo usa Alembic para correr DDL.
DATABASE_URL=postgresql+asyncpg://sportsdata:sportsdata@postgres:5432/sportsdata
# APP_DATABASE_URL: rol `app_user` (no-superuser, sujeto a RLS). Lo usa el
# runtime de la API. El rol lo crea la migración b2d4f6a8c0e1.
APP_DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_pwd@postgres:5432/sportsdata

# Nivel de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Token de root para crear tenants y mintear el primer API key (out-of-band).
# En prod este valor viene de un secret manager.
API_ROOT_ADMIN_TOKEN=change-me-in-dev

# Fallback de auth por X-Tenant-ID (sólo dev). En prod: false.
ALLOW_HEADER_TENANT_AUTH=true
