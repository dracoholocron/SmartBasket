# ─────────────────────────────────────────────────────────────────────────────
# SmartBasket Pipeline — CUDA + FFmpeg + OpenCV + YOLO
# Base: CUDA 12.1 + cuDNN 8 + Ubuntu 22.04
# ─────────────────────────────────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

LABEL maintainer="SmartBasket"
LABEL description="Basketball Highlight Pipeline — YOLO + FFmpeg + OpenCV"

# Evitar prompts interactivos en apt
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ─── Sistema: Python 3.11 + FFmpeg + dependencias CV ───
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    libglib2.0-0 \
    libsndfile1 \
    libgomp1 \
    git \
    wget \
    curl \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Hacer python3.11 el default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Actualizar pip
RUN python -m pip install --upgrade pip

# ─── PyTorch con CUDA 12.1 ───
RUN pip install --no-cache-dir \
    torch==2.2.2+cu121 \
    torchvision==0.17.2+cu121 \
    torchaudio==2.2.2+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# ─── Dependencias del pipeline ───
COPY basketball-highlight-agent/pyproject.toml /app/pyproject.toml
WORKDIR /app

RUN pip install --no-cache-dir \
    # CV y detección
    opencv-python-headless \
    ultralytics==8.2.0 \
    scenedetect[opencv]==0.6.3 \
    # Audio
    librosa==0.10.1 \
    soundfile==0.12.1 \
    pydub==0.25.1 \
    # Data y schemas
    pandas==2.2.1 \
    pydantic==2.6.4 \
    # Config y CLI
    pyyaml==6.0.1 \
    typer[all]==0.12.3 \
    rich==13.7.1 \
    python-dotenv==1.0.1 \
    # Video
    ffmpeg-python==0.2.0 \
    # HTTP para VLM service
    httpx==0.27.0 \
    # Utils
    tqdm==4.66.2 \
    loguru==0.7.2 \
    # Roboflow para descarga de modelos
    roboflow==1.1.35

# ─── Copiar código fuente ───
COPY basketball-highlight-agent/src /app/src
COPY basketball-highlight-agent/configs /app/configs
COPY basketball-highlight-agent/scripts /app/scripts

ENV PYTHONPATH=/app/src

# Verificar instalaciones críticas
RUN python -c "import cv2; print('OpenCV OK:', cv2.__version__)" && \
    python -c "import torch; print('Torch OK:', torch.__version__, '| CUDA:', torch.cuda.is_available())" && \
    python -c "from ultralytics import YOLO; print('Ultralytics OK')" && \
    ffmpeg -version | head -1

WORKDIR /app

# Instalar dependencias del VLM en una capa separada para no invalidar caché
RUN pip install --no-cache-dir \
    transformers==4.49.0 \
    huggingface_hub==0.36.2 \
    qwen-vl-utils==0.0.8 \
    accelerate==0.30.1 \
    bitsandbytes==0.43.1

# El entrypoint por defecto
CMD ["bash"]
