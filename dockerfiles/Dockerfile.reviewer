# ─────────────────────────────────────────────────────────────────────────────
# SmartBasket Reviewer — Streamlit UI (CPU only)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

LABEL maintainer="SmartBasket"
LABEL description="Basketball Highlight Reviewer UI — Streamlit"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instalar dependencias del sistema + Docker CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglib2.0-0 \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    streamlit==1.35.0 \
    pandas==2.2.1 \
    pydantic==2.6.4 \
    pyyaml==6.0.1 \
    loguru==0.7.2 \
    python-dotenv==1.0.1 \
    Pillow==10.3.0 \
    httpx==0.27.0 \
    opencv-python-headless==4.9.0.80 \
    streamlit-drawable-canvas==0.9.3

WORKDIR /app
COPY basketball-highlight-agent/src /app/src
COPY basketball-highlight-agent/configs /app/configs

ENV PYTHONPATH=/app/src
# Directorio de archivos estáticos de Streamlit (para servir videos sin cargarlos en RAM)
RUN mkdir -p /app/static

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "/app/src/basketball_highlights/reviewer_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.fileWatcherType=none", \
     "--server.maxUploadSize=2048", \
     "--server.enableStaticServing=true"]


