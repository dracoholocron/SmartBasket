# ─────────────────────────────────────────────────────────────────────────────
# SmartBasket VLM — CUDA + Qwen2.5-VL-3B-Instruct + FastAPI
# ─────────────────────────────────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

LABEL maintainer="SmartBasket"
LABEL description="Basketball Highlight VLM — Qwen2.5-VL-3B-Instruct"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ─── Sistema ───
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    ffmpeg \
    git \
    curl \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

RUN python -m pip install --upgrade pip

# ─── PyTorch con CUDA 12.1 ───
RUN pip install --no-cache-dir \
    torch==2.2.2+cu121 \
    torchvision==0.17.2+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# ─── HuggingFace + Qwen2.5-VL dependencies ───
RUN pip install --no-cache-dir \
    transformers==4.49.0 \
    accelerate==0.30.1 \
    bitsandbytes==0.43.1 \
    sentencepiece==0.2.0 \
    qwen-vl-utils==0.0.8 \
    # FastAPI service
    fastapi==0.111.0 \
    uvicorn[standard]==0.29.0 \
    # Schemas y utils
    pydantic==2.6.4 \
    opencv-python-headless==4.9.0.80 \
    Pillow==10.3.0 \
    numpy==1.26.4 \
    loguru==0.7.2 \
    python-dotenv==1.0.1 \
    pyyaml==6.0.1

WORKDIR /app
COPY basketball-highlight-agent/src /app/src
COPY basketball-highlight-agent/configs /app/configs

ENV PYTHONPATH=/app/src
ENV TRANSFORMERS_CACHE=/app/models/vlm
ENV HF_HOME=/app/models/vlm

# El modelo se carga lazy al primer request — no se descarga en build
EXPOSE 8001

CMD ["uvicorn", "basketball_highlights.vlm_service:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
